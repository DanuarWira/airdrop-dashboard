# ==========================================
# AirdropViewer Environment Variables
# ==========================================

# Port (Default: 3000)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=production

# Optional: Custom Telegram Scraping User-Agent
# TELEGRAM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64)

# Optional: Next.js Telemetry (0 to disable)
NEXT_TELEMETRY_DISABLED=1
